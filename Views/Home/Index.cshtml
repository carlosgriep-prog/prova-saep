<div class="p-4 bg-light rounded">
    <h2>Bem-vindo(a), @User.Identity?.Name!</h2>
    <p>Selecione uma das opções abaixo para gerenciar a clínica veterinária:</p>
    <div class="d-flex gap-2 mt-3">
        <a asp-controller="Tutores" asp-action="Index" class="btn btn-primary">Gerenciar Tutores</a>
        <a asp-controller="Pets" asp-action="Index" class="btn btn-success">Gerenciar Pets</a>
        <a asp-controller="Agendamentos" asp-action="Index" class="btn btn-warning">Gerenciar Agendamentos</a>
    </div>
</div>