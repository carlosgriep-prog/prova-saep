@model ClinicaVeterinaria.Models.Pet

<h3>Cadastrar Novo Pet</h3>
<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-2"><label>Nome do Pet</label><input asp-for="Nome" class="form-control" /></div>
    <div class="mb-2"><label>Espécie</label><input asp-for="Especie" class="form-control" placeholder="Ex: Cachorro, Gato" /></div>
    <div class="mb-2"><label>Raça</label><input asp-for="Raca" class="form-control" /></div>
    <div class="mb-3">
        <label>Tutor Responsável</label>
        <select asp-for="TutorId" asp-items="ViewBag.Tutores" class="form-select"></select>
    </div>
    <button type="submit" class="btn btn-success">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>