<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Clínica Veterinária - SAEP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Clínica Vet</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Início</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Tutores" asp-action="Index">Tutores</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Pets" asp-action="Index">Pets</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Agendamentos" asp-action="Index">Agendamentos</a></li>
                        </ul>
                        <span class="navbar-text text-white me-3">Olá, <strong>@User.Identity.Name</strong></span>
                        <a class="btn btn-outline-danger btn-sm" asp-controller="Account" asp-action="Logout">Sair</a>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">@RenderBody()</main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>