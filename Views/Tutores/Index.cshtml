@model List<ClinicaVeterinaria.ViewModels.TutorListaViewModel>

<h3>Tutores Cadastrados</h3>
<div class="d-flex justify-content-between my-3">
    <form method="get" class="d-flex gap-2">
        <input type="text" name="busca" value="@ViewBag.Busca" class="form-control" placeholder="Buscar por nome ou e-mail..." />
        <button type="submit" class="btn btn-secondary">Buscar</button>
    </form>
    <a asp-action="Create" class="btn btn-primary">+ Novo Tutor</a>
</div>

<table class="table table-bordered">
    <thead>
        <tr><th>Nome</th><th>CPF (Protegido)</th><th>Telefone</th><th>E-mail</th><th>Ações</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nome</td>
                <td>@item.CpfMascarado</td>
                <td>@item.Telefone</td>
                <td>@item.Email</td>
                <td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a></td>
            </tr>
        }
    </tbody>
</table>