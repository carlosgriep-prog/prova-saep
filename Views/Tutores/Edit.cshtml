@model ClinicaVeterinaria.ViewModels.TutorFormViewModel

<h3>Editar Tutor</h3>
<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-2"><label>Nome</label><input asp-for="Nome" class="form-control" /></div>
    <div class="mb-2"><label>CPF (11 números)</label><input asp-for="Cpf" class="form-control" maxlength="11" /></div>
    <div class="mb-2"><label>Telefone</label><input asp-for="Telefone" class="form-control" /></div>
    <div class="mb-3"><label>E-mail</label><input asp-for="Email" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Atualizar</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>